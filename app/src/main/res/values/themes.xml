<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmokingQuitSystem" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/panel_dark</item>
    </style>

    <style name="Theme.SmokingQuitSystem.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SmokingQuitSystem</item>
    </style>
</resources>
